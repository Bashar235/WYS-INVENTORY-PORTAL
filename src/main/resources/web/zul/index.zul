                        <div class="site-project-img"><img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="[Project 3]"/></div>
                        <div class="site-project-body">
                            <span class="site-project-caption">[Project Name 3] — Retail Chain Stockrooms</span>
                            <span class="site-project-tag">Retail Inventory</span>
                        </div>
                    </div>
                    <div class="site-project">
                        <div class="site-project-img"><img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="[Project 4]"/></div>
                        <div class="site-project-body">
                            <span class="site-project-caption">[Project Name 4] — Manufacturing Parts Tracking</span>
                            <span class="site-project-tag">Inventory Auditing</span>
                        </div>
                    </div>
                    <div class="site-project">
                        <div class="site-project-img"><img src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="[Project 5]"/></div>
                        <div class="site-project-body">
                            <span class="site-project-caption">[Project Name 5] — e-Commerce Fulfillment Hub</span>
                            <span class="site-project-tag">Fulfillment Operations</span>
                        </div>
                    </div>
                    <div class="site-project">
                        <div class="site-project-img"><img src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="[Project 6]"/></div>
                        <div class="site-project-body">
                            <span class="site-project-caption">[Project Name 6] — Pharmaceutical Compliance</span>
                            <span class="site-project-tag">Compliance Tracking</span>
