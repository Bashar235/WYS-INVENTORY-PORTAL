        <!-- ══ CONTACT ═══════════════════════════════════════════════════ -->
        <section class="site-section" id="contact">
            <div class="site-container">
                <div class="site-section-head">
                    <span class="site-eyebrow">Get In Touch</span>
                    <span class="site-title">Ready to Optimize Your Warehouse?</span>
                    <p class="site-lead">
                        Whether you're looking to overhaul your inventory systems or simply need expert guidance, our team is ready to help you find the right solution.
                    </p>
                </div>
                <div class="site-contact">
                    <div>
                        <div class="site-contact-item">
                            <span class="site-contact-label">Address</span>
                            <span class="site-contact-value">[Street Address]<br/>[City, State, ZIP Code]</span>
                        </div>
                        <div class="site-contact-item">
                            <span class="site-contact-label">Phone</span>
                            <span class="site-contact-value">+1 (800) [PHONE-NUMBER]</span>
                        </div>
                        <div class="site-contact-item">
                            <span class="site-contact-label">Email</span>
                            <span class="site-contact-value">[contact@wys-inventory.com]</span>
                        </div>
                        <div class="site-contact-item">
                            <span class="site-contact-label">Business Hours</span>
                            <span class="site-contact-value">Monday – Friday: 8AM – 6PM<br/>Saturday: 9AM – 2PM</span>
                        </div>
                    </div>
                    <div class="site-form">
                        <h3 class="site-form-title">Send Us a Message</h3>
                        <div class="site-form-field">
                            <label class="site-form-label">Full Name *</label>
                            <input type="text" class="site-input" placeholder="Your full name"/>
                        </div>
                        <div class="site-form-field">
                            <label class="site-form-label">Email Address *</label>
                            <input type="email" class="site-input" placeholder="your@email.com"/>
                        </div>
                        <div class="site-form-field">
                            <label class="site-form-label">Message *</label>
                            <textarea class="site-input" placeholder="Tell us about your project or inquiry..." rows="5"></textarea>
                        </div>
                        <button class="site-submit" onclick="alert('Thank you! Your message has been sent. We will be in touch within 24 hours.');">Send Message</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ PORTAL CTA ════════════════════════════════════════════════ -->
        <section class="site-portal">
            <div class="site-portal-inner">
                <h2 class="site-portal-title">Ready to Launch the Inventory Portal?</h2>
