        <!-- ══ HERO ══════════════════════════════════════════════════════ -->
        <header class="site-hero">
            <span class="site-hero-eyebrow">Established [Year] · Trusted Warehouse Partner</span>
            <h1 class="site-hero-title">Excellence Built on <span class="site-accent">Solid Ground</span></h1>
            <p class="site-hero-text">
                WYS delivers enterprise-grade warehouse inventory management solutions — combining precision logistics, real-time stock intelligence, and proven operational frameworks to keep your supply chain running at peak performance.
            </p>
            <div class="site-cta-row">
                <a href="zul/login.zul" class="site-btn-primary">View Projects</a>
                <a href="#contact" class="site-btn-secondary">Contact Us</a>
            </div>
            <div class="site-stats">
                <div>
                    <span class="site-stat-num">[<span>YR</span>]</span>
                    <span class="site-stat-label">Year Established</span>
                </div>
                <div>
                    <span class="site-stat-num">300<span>+</span></span>
                    <span class="site-stat-label">Projects Completed</span>
                </div>
                <div>
                    <span class="site-stat-num">120<span>+</span></span>
                    <span class="site-stat-label">Employees</span>
                </div>
                <div>
                    <span class="site-stat-num">85<span>+</span></span>
                    <span class="site-stat-label">Business Partners</span>
                </div>
            </div>
        </header>

        <!-- ══ INTRO ═════════════════════════════════════════════════════ -->
        <section class="site-intro">
            <div class="site-intro-inner">
                <div class="site-intro-headline">Inventory Management Is What We Do.</div>
                <div class="site-intro-divider"></div>
                <div class="site-intro-text">
                    WYS empowers businesses to take full control of their warehouse operations — delivering accurate, real-time inventory visibility that drives smarter decisions and measurable results across every level of your supply chain.
                </div>
            </div>
        </section>

        <!-- ══ SERVICES ══════════════════════════════════════════════════ -->
        <section class="site-section site-section-alt" id="services">
            <div class="site-container">
                <div class="site-section-head">
                    <span class="site-eyebrow">What We Offer</span>
                    <span class="site-title">Core Service Areas</span>
                </div>
                <div class="site-grid-3">
                    <div class="site-card">
                        <img src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="Warehouse Management"/>
                        <div class="site-card-body">
                            <span class="site-card-title">Warehouse Management</span>
                            <span class="site-card-text">End-to-end warehouse operations oversight — from receiving and putaway to picking, packing, and dispatch — engineered for maximum throughput and zero-error fulfillment.</span>
                            <a href="#contact" class="site-link">Read more ›</a>
                        </div>
                    </div>
                    <div class="site-card">
                        <img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="Inventory Auditing"/>
                        <div class="site-card-body">
                            <span class="site-card-title">Inventory Auditing</span>
                            <span class="site-card-text">Rigorous cycle counts, perpetual inventory tracking, and comprehensive audit trails ensuring your stock records match physical reality at all times — with full compliance reporting.</span>
                            <a href="#contact" class="site-link">Read more ›</a>
                        </div>
                    </div>
                    <div class="site-card">
                        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&amp;auto=format&amp;fit=crop&amp;q=80" alt="Supply Chain Consulting"/>
                        <div class="site-card-body">
                            <span class="site-card-title">Supply Chain Consulting</span>
                            <span class="site-card-text">Strategic advisory services to optimize your inbound logistics, vendor relationships, reorder points, and overall supply chain resilience — tailored to your industry.</span>
                            <a href="#contact" class="site-link">Read more ›</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ ABOUT ═════════════════════════════════════════════════════ -->
        <section class="site-section" id="about">
            <div class="site-container">
                <div class="site-about">
                    <div class="site-about-image">
                        <img src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?w=800&amp;auto=format&amp;fit=crop&amp;q=80" alt="WYS Warehouse Operations"/>
                        <div class="site-about-badge">
                            <span class="site-about-badge-num">15+</span>
                            <span class="site-about-badge-label">Years of Excellence</span>
                        </div>
                    </div>
                    <div>
                        <span class="site-eyebrow">Who We Are</span>
                        <span class="site-title">Built on Operational Integrity</span>
                        <p class="site-about-body">
                            WYS was founded with a single mission: to give businesses complete, confident command over their warehouse inventory. Over [Year Founded], we have grown into a trusted partner for distributors, manufacturers, and retailers across the region — providing the systems, processes, and expertise that eliminate stock discrepancies and drive operational excellence.
                        </p>
                        <div class="site-quote">
                            <span class="site-quote-text">
                                "We built WYS because we saw too many businesses losing revenue to invisible inventory problems. Our platform makes the invisible visible — in real time, every time."
                            </span>
                            <span class="site-quote-author">[Founder Name] — Founder &amp; CEO</span>
                            <span class="site-quote-role">WYS Warehouse Inventory Solutions</span>
                        </div>
                        <div class="site-mini-stats">
                            <div class="site-mini-stat">
                                <span class="site-mini-stat-num">[<span>YR</span>]</span>
                                <span class="site-mini-stat-label">Established</span>
                            </div>
                            <div class="site-mini-stat">
                                <span class="site-mini-stat-num">300<span>+</span></span>
                                <span class="site-mini-stat-label">Projects</span>
                            </div>
                            <div class="site-mini-stat">
                                <span class="site-mini-stat-num">120<span>+</span></span>
                                <span class="site-mini-stat-label">Employees</span>
                            </div>
                            <div class="site-mini-stat">
                                <span class="site-mini-stat-num">85<span>+</span></span>
                                <span class="site-mini-stat-label">Partners</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ CAPABILITIES ══════════════════════════════════════════════ -->
        <section class="site-section site-section-alt">
            <div class="site-container">
                <div class="site-section-head">
                    <span class="site-eyebrow">Full Capabilities</span>
                    <span class="site-title">Everything You Need, Under One Roof</span>
                </div>
                <div class="site-grid-4">
                    <div class="site-tile">
                        <span class="site-tile-num">01</span>
                        <span class="site-tile-title">Stock Control &amp; Replenishment</span>
                        <span class="site-tile-text">Automated reorder points, safety stock calculations, and supplier-facing purchase orders to prevent costly stockouts.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">02</span>
                        <span class="site-tile-title">Cycle Counting &amp; Reconciliation</span>
                        <span class="site-tile-text">Scheduled and ad-hoc cycle counts with variance reporting and root-cause analysis workflows built in.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">03</span>
                        <span class="site-tile-title">Real-Time Tracking</span>
                        <span class="site-tile-text">Live inventory dashboards with barcode/RFID integration for accurate, up-to-the-second stock visibility across all locations.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">04</span>
                        <span class="site-tile-title">Warehouse Layout Design</span>
                        <span class="site-tile-text">Slotting optimization, zone configuration, and traffic-flow analysis to maximize picking efficiency and reduce travel time.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">05</span>
                        <span class="site-tile-title">Receiving &amp; Putaway</span>
                        <span class="site-tile-text">Structured inbound processes with quality inspection checkpoints, PO matching, and directed putaway logic for peak accuracy.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">06</span>
                        <span class="site-tile-title">Dispatch &amp; Shipping Mgmt</span>
                        <span class="site-tile-text">Outbound order management, carrier integration, and packing list generation with complete audit trails for every shipment.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">07</span>
                        <span class="site-tile-title">Inventory Analytics</span>
                        <span class="site-tile-text">Custom KPI dashboards, turnover ratio analysis, dead-stock identification, and executive-ready periodic reports.</span>
                    </div>
                    <div class="site-tile">
                        <span class="site-tile-num">08</span>
                        <span class="site-tile-title">System Integration &amp; Migration</span>
                        <span class="site-tile-text">Seamless ERP, WMS, and e-commerce platform integrations with zero data-loss migration guarantees and expert onboarding.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ PROJECTS ══════════════════════════════════════════════════ -->
